# Backend API base URL (res_proxy).
# Development — used by `vite` (dev server). Copy this file to .env.
# Production values live in .env.production / Vercel environment settings.
VITE_SERVER_URL=http://localhost:4000

# Google Analytics 4 measurement ID (looks like G-XXXXXXXXXX).
# Leave blank to disable analytics entirely — no script is loaded and every
# tracking call becomes a no-op. Set it in Vercel's environment settings for
# production; leaving it out of local .env keeps dev traffic out of reports.
VITE_GA_MEASUREMENT_ID=

# Set to "true" to also send events from `npm run dev`. Off by default so
# local clicking does not pollute production data.
VITE_GA_DEBUG=false
